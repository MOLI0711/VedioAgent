HTTP_ADDR=:8080
# Keep scrape endpoints on a private interface; override when Prometheus scrapes over an internal network.
API_METRICS_ADDR=127.0.0.1:9091
BACKGROUND_METRICS_ADDR=127.0.0.1:9093
DATABASE_URL=postgres://mirrorcore:mirrorcore-local-only@localhost:5432/mirrorcore?sslmode=disable
KAFKA_BROKERS=localhost:9092
OSS_REGION=cn-beijing
OSS_ENDPOINT=
OSS_BUCKET=
OSS_CREDENTIAL_MODE=env
# Required for env credential mode; session token is only for temporary credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TEMP_DIR=/tmp/mirrorcore-media
BAILIAN_REGION=cn-beijing
BAILIAN_WORKSPACE_ID=
BAILIAN_API_KEY=
# Fill these from the provider console; API and background must use matching values.
BAILIAN_EMBEDDING_RPM=
BAILIAN_EMBEDDING_TPM=
BAILIAN_QWEN_RPM=
BAILIAN_QWEN_TPM=
COOKIE_SECURE=false
LOCAL_DEMO_MODE=false
BOOTSTRAP_EMAIL=demo@mirrorcore.local
BOOTSTRAP_PASSWORD=change-me-before-use
